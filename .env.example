# Resend API key — required for contact form emails
# Get yours at https://resend.com
RESEND_API_KEY=

# Email address that receives contact form submissions
CONTACT_EMAIL=your@email.com

# Public site URL (used for OG metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Postgres (Neon) for stored messages, read by the Sarmadax Console. Run db/0001_messages.sql once.
DATABASE_URL=

# Shared with PORTFOLIO_CONSOLE_SECRET on the Sarmadax Console (32+ characters)
CONSOLE_API_SECRET=
